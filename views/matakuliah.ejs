<%- include('partials/header') %>

<div class="max-w-7xl mx-auto space-y-4 sm:space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-4 sm:mb-8">
        <div class="flex items-center space-x-3 w-full sm:w-auto">
            <div class="w-10 h-10 sm:w-12 sm:h-12 bg-gradient-to-br from-green-500 to-green-600 rounded-xl flex items-center justify-center shadow-lg shrink-0">
                <svg class="w-5 h-5 sm:w-6 sm:h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                </svg>
            </div>
            <div>
                <h1 class="text-lg sm:text-2xl font-bold text-gray-800">Mata Kuliah</h1>
                <p class="text-xs sm:text-sm text-gray-500">
                    Total: <span class="font-semibold text-green-600"><%= courses.length %></span> mata kuliah
                </p>
            </div>
        </div>
        <a href="/matakuliah/add" class="w-full sm:w-auto justify-center inline-flex items-center px-4 sm:px-6 py-2.5 sm:py-3 bg-gradient-to-r from-green-500 to-green-600 hover:from-green-600 hover:to-green-700 text-white text-sm sm:text-base font-semibold rounded-xl shadow-lg hover:shadow-xl transform sm:hover:-translate-y-0.5 transition-all duration-200">
            <svg class="w-4 h-4 sm:w-5 sm:h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
            </svg>
            Tambah Mata Kuliah
        </a>
    </div>
    
    <% if (courses.length === 0) { %>
        <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-8 sm:p-12 text-center">
            <div class="w-16 h-16 sm:w-20 sm:h-20 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4 sm:mb-6">
                <svg class="w-8 h-8 sm:w-10 sm:h-10 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                </svg>
            </div>
            <h3 class="text-base sm:text-lg font-semibold text-gray-800 mb-2">Belum ada mata kuliah</h3>
            <p class="text-sm sm:text-base text-gray-500 mb-6">Mulai dengan menambahkan mata kuliah pertama</p>
            <a href="/matakuliah/add" class="w-full sm:w-auto justify-center inline-flex items-center px-6 py-3 bg-gradient-to-r from-green-500 to-green-600 hover:from-green-600 hover:to-green-700 text-white font-semibold rounded-xl shadow-lg hover:shadow-xl transform transition-all duration-200">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                </svg>
                Tambah Mata Kuliah
            </a>
        </div>
        <% } else { %>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
                <% courses.forEach(course => { %>
                    <div class="bg-white rounded-2xl border border-gray-200 shadow-sm hover:shadow-lg transition-all duration-200 overflow-hidden group flex flex-col">
                        <div class="bg-gradient-to-r from-green-50 to-emerald-50 p-4 sm:p-6 border-b border-gray-100">
                            <div class="flex items-start justify-between gap-3">
                                <div class="flex-1 min-w-0">
                                    <h3 class="text-base sm:text-lg font-bold text-gray-800 mb-1.5 group-hover:text-green-600 transition-colors duration-200 truncate" title="<%= course.name %>">
                                        <%= course.name %>
                                    </h3>
                                    <div class="flex flex-wrap items-center gap-1.5 sm:gap-2 text-[10px] sm:text-xs lg:text-sm text-gray-600">
                                        <span class="bg-green-100 text-green-700 px-2 py-0.5 sm:py-1 rounded-lg font-medium whitespace-nowrap">
                                            <%= course.code %>
                                        </span>
                                        <span class="text-gray-400 hidden sm:inline">•</span>
                                        <span class="whitespace-nowrap font-medium text-gray-500"><%= course.credits %> SKS</span>
                                    </div>
                                </div>
                                <div class="text-[10px] sm:text-xs text-gray-400 font-mono bg-white px-2 py-1 rounded-lg shrink-0 mt-0.5 border border-gray-100">
                                    #<%= course.id %>
                                </div>
                            </div>
                        </div>
                        
                        <div class="p-4 sm:p-6 flex-1">
                            <div class="space-y-2.5 sm:space-y-3">
                                <% if (course.description) { %>
                                    <div>
                                        <p class="text-xs sm:text-sm text-gray-600 line-clamp-3" title="<%= course.description %>">
                                            <%= course.description %>
                                        </p>
                                    </div>
                                    <% } %>
                                    
                                    <% if (course.department) { %>
                                        <div class="flex items-center space-x-2 text-xs sm:text-sm text-gray-600">
                                            <div class="w-6 h-6 rounded-md bg-gray-50 flex items-center justify-center shrink-0">
                                                <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                                                </svg>
                                            </div>
                                            <span class="truncate" title="<%= course.department %>"><%= course.department %></span>
                                        </div>
                                        <% } %>
                                        
                                        <% if (course.semester) { %>
                                            <div class="flex items-center space-x-2 text-xs sm:text-sm text-gray-600">
                                                <div class="w-6 h-6 rounded-md bg-gray-50 flex items-center justify-center shrink-0">
                                                    <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                                    </svg>
                                                </div>
                                                <span>Semester <%= course.semester %></span>
                                            </div>
                                            <% } %>
                                        </div>
                                    </div>
                                    
                                    <div class="px-4 pb-4 sm:px-6 sm:pb-6 mt-auto">
                                        <div class="flex space-x-2">
                                            <a href="/matakuliah/edit/<%= course.id %>" class="flex-1 inline-flex items-center justify-center px-3 py-2 sm:px-4 sm:py-2.5 bg-blue-50 hover:bg-blue-100 text-blue-600 text-xs sm:text-sm font-medium rounded-lg transition-colors duration-200">
                                                <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 mr-1.5 sm:mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                                                </svg>
                                                Edit
                                            </a>
                                            <button onclick="deleteCourse('<%= course.id %>', '<%= course.name %>')" class="flex-1 inline-flex items-center justify-center px-3 py-2 sm:px-4 sm:py-2.5 bg-red-50 hover:bg-red-100 text-red-600 text-xs sm:text-sm font-medium rounded-lg transition-colors duration-200">
                                                <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 mr-1.5 sm:mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                                </svg>
                                                Hapus
                                            </button>
                                        </div>
                                    </div>
                                </div>
                                <% }); %>
                            </div>
                            <% } %>
                        </div>
                        
                        <script>
                            function deleteCourse(id, name) {
                                if (confirm(`Apakah Anda yakin ingin menghapus mata kuliah "${name}"?\n\nTindakan ini tidak dapat dibatalkan.`)) {
                                    fetch(`/matakuliah/delete/${id}`, {
                                        method: 'DELETE',
                                        headers: {
                                            'Content-Type': 'application/json',
                                        }
                                    })
                                    .then(response => {
                                        if (response.ok) {
                                            location.reload();
                                        } else {
                                            alert('Gagal menghapus mata kuliah. Silakan coba lagi.');
                                        }
                                    })
                                    .catch(error => {
                                        console.error('Error:', error);
                                        alert('Terjadi kesalahan. Silakan coba lagi.');
                                    });
                                }
                            }
                        </script>
                        
                        <%- include('partials/footer') %>