<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    
    <!-- MENGGUNAKAN TAILWIND CSS VIA CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: {
                            50: '#eff6ff',
                            500: '#3b82f6',
                            600: '#2563eb',
                            700: '#1d4ed8',
                            900: '#1e3a8a'
                        }
                    }
                }
            }
        }
    </script>
    
    <style>
        .sidebar { 
            width: 320px; 
            transition: all 0.3s ease;
        }
        .sidebar.collapsed { 
            width: 80px; 
        }
        
        /* Improved sidebar content handling */
        .sidebar-content {
            transition: all 0.3s ease;
        }
        .sidebar.collapsed .sidebar-content {
            display: none; /* Changed from opacity to display for better positioning */
        }
        
        /* Sidebar mini positioning */
        .sidebar-mini {
            display: none; /* Hidden by default */
            transition: all 0.3s ease;
        }
        .sidebar.collapsed .sidebar-mini {
            display: block; /* Show when collapsed */
        }
        
        /* Improved logo container */
        .logo-container {
            background: linear-gradient(135deg, rgba(99, 102, 241, 0.05), rgba(168, 85, 247, 0.05));
            border: 1px solid rgba(99, 102, 241, 0.1);
            position: relative;
            overflow: hidden;
        }
        .logo-container::after {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, transparent, rgba(255,255,255,0.4), transparent);
            transform: translateX(-100%);
            transition: transform 0.5s ease;
        }
        .logo-container:hover::after {
            transform: translateX(100%);
        }

        /* Sidebar collapsed adjustment - Stack logo and btn vertically */
        .sidebar.collapsed .sidebar-header {
            flex-direction: column;
            gap: 1.25rem;
            padding: 1.5rem 0.5rem;
            align-items: center;
        }
        .sidebar.collapsed .sidebar-header .sidebar-mini {
            display: flex;
            justify-content: center;
        }
        .sidebar.collapsed #collapseBtn {
            width: 32px;
            height: 32px;
        }
        
        .beautiful-shadow {
            box-shadow: 0px 0px 0px 1px rgba(0,0,0,0.06), 0px 1px 1px -0.5px rgba(0,0,0,0.06), 0px 3px 3px -1.5px rgba(0,0,0,0.06), 0px 6px 6px -3px rgba(0,0,0,0.06), 0px 12px 12px -6px rgba(0,0,0,0.06), 0px 24px 24px -12px rgba(0,0,0,0.06);
        }
        .main-content {
            margin-left: 320px;
            transition: all 0.3s ease;
        }
        .main-content.sidebar-collapsed {
            margin-left: 80px;
        }
        @media (max-width: 1024px) {
            .main-content, .main-content.sidebar-collapsed {
                margin-left: 0;
            }
        }
        .scroll-hide::-webkit-scrollbar { display: none; }
        .scroll-hide { -ms-overflow-style: none; scrollbar-width: none; }
    </style>
</head>
