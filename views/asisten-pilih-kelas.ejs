<%- include('partials/header') %>

<div class="max-w-6xl mx-auto space-y-6">
    <!-- Page Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div class="flex items-center space-x-4">
            <a href="/laporan" class="group inline-flex items-center justify-center w-10 h-10 bg-white hover:bg-gray-900 border border-gray-200 text-gray-500 hover:text-white rounded-xl transition-all duration-200 shadow-sm">
                <svg class="w-5 h-5" data-lucide="chevron-left"></svg>
            </a>
            <div>
                <h2 class="text-2xl font-black text-gray-900 tracking-tight">Pilih Jadwal Kelas</h2>
                <div class="flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-indigo-500"></span>
                    <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Silakan pilih hari untuk mengisi laporan</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Info Banner -->
    <!-- <div class="bg-gradient-to-r from-blue-50 to-indigo-50 rounded-2xl p-6 border border-blue-100">
        <div class="flex items-start space-x-4">
            <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center">
                <svg class="w-6 h-6 text-blue-600" data-lucide="info"></svg>
            </div>
            <div>
                <h3 class="text-lg font-semibold text-blue-900 mb-2">Tentang View Asisten</h3>
