                    <p>• <strong>Semua tanggal clickable</strong> = Langsung ke form dengan data terisi otomatis</p>
                </div>
            </div>
        </div>
    </div> -->

    <!-- Classes Grid (Reorganized to 3x3) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% 
        const dayOrder = ['Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu', 'Minggu'];
        dayOrder.forEach((day, index) => { 
            const dayClasses = classes.filter(c => c.day === day);
        %>
            <div class="flex flex-col bg-white rounded-[32px] border border-gray-100 shadow-sm p-6 min-h-[340px] transition-all hover:shadow-md">
                <!-- Day Header -->
                <div class="flex items-center justify-between mb-6 pb-4 border-b border-gray-50">
                    <div class="flex items-center space-x-3">
                        <div class="w-10 h-10 bg-slate-50 rounded-xl flex items-center justify-center border border-slate-100 shadow-inner">
                            <svg class="w-5 h-5 text-slate-500" data-lucide="calendar-days"></svg>
                        </div>
                        <div>
                            <h3 class="text-base font-black text-slate-900"><%= day %></h3>
                            <p class="text-[9px] text-slate-400 font-bold uppercase tracking-[0.15em]">Weekly Schedule</p>
                        </div>
                    </div>
                    <% if (dayClasses.length > 0) { %>
                        <div class="flex items-center gap-1.5 px-3 py-1 bg-indigo-50 text-indigo-600 rounded-full border border-indigo-100/50">
                            <span class="w-1.5 h-1.5 rounded-full bg-indigo-500 animate-pulse"></span>
                            <span class="text-[10px] font-black uppercase"><%= dayClasses.length %> Active</span>
                        </div>
                    <% } %>
                </div>
                
                <!-- Classes List -->
                <div class="space-y-4 flex-grow">
                    <% if (dayClasses.length > 0) { %>
                        <% dayClasses.forEach(classItem => { %>
                            <a href="/laporan/asisten/kelas/<%= classItem.scheduleId %>" class="group block">
                                <div class="bg-slate-50 p-4 rounded-2xl border border-slate-100 group-hover:bg-white group-hover:border-indigo-200 group-hover:shadow-lg group-hover:-translate-y-1 transition-all duration-300">
                                    <div class="flex items-center justify-between mb-2.5">
                                        <span class="inline-flex items-center px-2 py-1 rounded-lg bg-white border border-slate-200 text-[10px] font-black text-indigo-600 shadow-sm">
                                            Class <%= classItem.class %>
                                        </span>
                                        <div class="flex items-center text-[10px] text-slate-400 font-bold bg-white px-2 py-1 rounded-lg border border-slate-100">
                                            <svg class="w-3 h-3 mr-1" data-lucide="clock"></svg>
                                            <%= classItem.time %>
                                        </div>
                                    </div>
                                    
                                    <h4 class="text-sm font-black text-slate-800 leading-snug group-hover:text-indigo-600 transition-colors">
                                        <%= classItem.courseName %>
                                    </h4>
                                    <p class="text-[10px] text-slate-500 mt-1 font-medium italic">
                                        <%= classItem.lecturerName %>
                                    </p>
                                    
                                    <div class="mt-4 pt-3 border-t border-slate-200/50 flex items-center justify-between">
                                        <div class="flex -space-x-2">
                                            <div class="w-6 h-6 rounded-full bg-indigo-100 border-2 border-white flex items-center justify-center z-10">
                                                <svg class="w-3 h-3 text-indigo-600" data-lucide="user"></svg>
                                            </div>
                                            <div class="w-6 h-6 rounded-full bg-slate-100 border-2 border-white flex items-center justify-center text-[9px] font-bold text-slate-500">
                                                +<%= (classItem.assistants ? classItem.assistants.length : 1) - 1 %>
                                            </div>
                                        </div>
                                        <span class="text-[9px] font-black text-indigo-500 uppercase flex items-center gap-1 group-hover:gap-2 transition-all">
                                            Masuk Kelas <svg class="w-3 h-3" data-lucide="arrow-right"></svg>
                                        </span>
                                    </div>
                                </div>
                            </a>
                        <% }) %>
                    <% } else { %>
                        <div class="flex-grow flex flex-col items-center justify-center bg-slate-50/50 rounded-2xl border border-dashed border-slate-200 p-8">
                            <div class="w-12 h-12 bg-white rounded-xl shadow-sm flex items-center justify-center mb-3">
                                <svg class="w-6 h-6 text-slate-300" data-lucide="coffee"></svg>
                            </div>
                            <p class="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em]">Free Day</p>
                        </div>
                    <% } %>
                </div>
            </div>
        <% }) %>

        <!-- Integrated Quick Stats (Slots 8 & 9) -->
        <div class="bg-gradient-to-br from-purple-600 to-indigo-700 rounded-[32px] p-6 text-white shadow-xl flex flex-col justify-between relative overflow-hidden group">
            <div class="absolute top-0 right-0 -mt-10 -mr-10 w-40 h-40 bg-white/10 rounded-full blur-3xl group-hover:scale-125 transition-transform duration-1000"></div>
            <div class="relative z-10">
                <div class="w-14 h-14 bg-white/20 rounded-2xl flex items-center justify-center mb-6 backdrop-blur-md border border-white/20">
                    <svg class="w-8 h-8 text-white" data-lucide="layout-grid"></svg>
                </div>
                <h4 class="text-purple-100 text-sm font-medium tracking-wide">Total Ringkasan Kelas</h4>
                <div class="flex items-baseline space-x-2 mt-1">
                    <p class="text-5xl font-black tracking-tight"><%= classes.length %></p>
                    <span class="text-purple-200 text-xs font-bold uppercase">Mata Kuliah</span>
                </div>
            </div>
            <div class="relative z-10 mt-6 pt-5 border-t border-white/10">
                <div class="flex items-center justify-between text-[11px] text-purple-100">
                    <div class="flex items-center">
                        <div class="w-2 h-2 bg-green-400 rounded-full mr-2 shadow-[0_0_8px_rgba(74,222,128,0.5)]"></div>
                        <span><%= [...new Set(classes.map(c => c.day))].length %> Hari Terjadwal</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-[32px] p-8 border border-gray-100 shadow-sm flex flex-col justify-between relative overflow-hidden group hover:shadow-md transition-shadow">
            <div class="flex items-start justify-between">
                <div>
                    <p class="text-[10px] font-black text-gray-400 uppercase tracking-[0.2em] mb-1">Database</p>
                    <h4 class="text-2xl font-black text-gray-900 leading-none">Asisten</h4>
                </div>
                <div class="w-14 h-14 bg-blue-50 rounded-2xl flex items-center justify-center text-blue-500">
                    <svg class="w-8 h-8" data-lucide="users"></svg>
                </div>
            </div>
            
            <div class="mt-4">
                <p class="text-4xl font-black text-blue-600"><%= assistants.length %></p>
                <p class="text-xs text-gray-500 mt-2 leading-relaxed">
                    Total asisten yang terdaftar dan aktif dalam penjadwalan periode ini.
                </p>
            </div>
            
            <div class="mt-8">
                <a href="/management/asisten" class="group/btn w-full inline-flex items-center justify-center px-6 py-3 bg-gray-900 hover:bg-black text-white text-xs font-bold rounded-2xl transition-all shadow-lg hover:shadow-gray-200">
                    Panel Manajemen <svg class="w-4 h-4 ml-2 transform group-hover/btn:translate-x-1 transition-transform" data-lucide="arrow-right"></svg>
                </a>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %> 