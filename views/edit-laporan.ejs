<%- include('partials/header') %>

<div class="max-w-6xl mx-auto space-y-6">
    <div class="flex items-center space-x-4">
        <a href="/laporan" class="inline-flex items-center px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium rounded-xl transition-colors duration-200">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
            </svg>
            Kembali
        </a>
        <div>
            <h2 class="text-2xl font-bold text-gray-800">Edit Laporan</h2>
            <p class="text-sm text-gray-600">Perbarui informasi laporan kegiatan</p>
        </div>
    </div>

    <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
        <div class="bg-gradient-to-r from-indigo-50 to-purple-50 p-6 border-b border-gray-100">
            <h3 class="text-lg font-semibold text-gray-800">Informasi Laporan</h3>
            <p class="text-sm text-gray-600 mt-1">Lengkapi semua informasi yang diperlukan</p>
        </div>

        <form action="/laporan/update/<%= report.id %>" method="POST" class="p-6">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                <div class="space-y-6">
                    <div class="bg-gray-50 rounded-xl p-4">
                        <h4 class="text-sm font-semibold text-gray-700 mb-3">Informasi Jadwal</h4>
                        
                        <div class="space-y-2">
                            <label for="scheduleId" class="block text-sm font-semibold text-gray-700">
                                Jadwal <span class="text-red-500">*</span>
                            </label>
                            <div class="relative">
                                <select 
                                    name="scheduleId" 
                                    id="scheduleId" 
                                    required
                                    class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors duration-200 bg-white appearance-none"
                                >
                                    <option value="">Pilih Jadwal</option>
                                    <% schedules.forEach(schedule => { %>
                                        <option value="<%= schedule.id %>" <%= report.schedule_id === schedule.id ? 'selected' : '' %>>
                                            <%= schedule.course ? schedule.course.name : 'Mata Kuliah Tidak Ditemukan' %> - 
                                            Kelas <%= schedule.class %> - 
                                            <%= schedule.day %> <%= schedule.time %>
                                        </option>
                                    <% }) %>
                                </select>
                                <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none">
                                    <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                                    </svg>
                                </div>
                            </div>
                        </div>

                        <div class="space-y-2">
                            <label for="date" class="block text-sm font-semibold text-gray-700">
                                Tanggal <span class="text-red-500">*</span>
                            </label>
                            <input 
                                type="date" 
                                name="date" 
                                id="date" 
                                value="<%= new Date(report.date).toISOString().split('T')[0] %>"
                                required
                                class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors duration-200 bg-white"
                            />
                        </div>
                    </div>

                    <div class="space-y-2">
                        <label for="status" class="block text-sm font-semibold text-gray-700">
                            Status Laporan <span class="text-red-500">*</span>
                        </label>
                        <div class="relative">
                            <select 
                                name="status" 
                                id="status" 
                                required
                                class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors duration-200 bg-white appearance-none"
                            >
                                <option value="hadir" <%= report.status === 'hadir' ? 'selected' : '' %>>Hadir</option>
                                <option value="libur" <%= report.status === 'libur' ? 'selected' : '' %>>Libur</option>
                                <option value="pengganti" <%= report.status === 'pengganti' ? 'selected' : '' %>>Pengganti</option>
                                <option value="belum ada laporan" <%= report.status === 'belum ada laporan' ? 'selected' : '' %>>Belum Ada Laporan</option>
                            </select>
                            <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none">
                                <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                                </svg>
                            </div>
                        </div>
                    </div>

                    <div class="space-y-2">
                        <label for="materi" class="block text-sm font-semibold text-gray-700">
                            Materi
                        </label>
                        <input 
                            type="text" 
                            name="materi" 
                            id="materi" 
                            value="<%= report.materi || '' %>"
                            placeholder="Masukkan materi yang diajarkan"
                            class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors duration-200 bg-gray-50 focus:bg-white"
                        />
                    </div>
                </div>

                <div class="space-y-6">
                    <div class="space-y-2">
                        <label for="deskripsiKegiatan" class="block text-sm font-semibold text-gray-700">
                            Deskripsi Kegiatan
                        </label>
                        <textarea 
                            name="deskripsiKegiatan" 
                            id="deskripsiKegiatan" 
                            rows="4"
                            placeholder="Jelaskan kegiatan yang dilakukan selama praktikum"
                            class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors duration-200 bg-gray-50 focus:bg-white resize-none"
                        ><%= report.deskripsiKegiatan || '' %></textarea>
                    </div>

                    <div class="space-y-2">
                        <label for="keterangan" class="block text-sm font-semibold text-gray-700">
                            Keterangan Tambahan
                        </label>
                        <textarea 
                            name="keterangan" 
                            id="keterangan" 
                            rows="3"
                            placeholder="Catatan atau keterangan tambahan"
                            class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors duration-200 bg-gray-50 focus:bg-white resize-none"
                        ><%= report.keterangan || '' %></textarea>
                    </div>

                    <div class="space-y-2">
                        <label class="block text-sm font-semibold text-gray-700">
                            Asisten yang Hadir
                        </label>
                        <div class="bg-gray-50 rounded-xl p-4 max-h-48 overflow-y-auto">
                            <% if (assistants && assistants.length > 0) { %>
                                <div class="grid grid-cols-1 gap-2">
                                    <% assistants.forEach(assistant => { %>
                                        <label class="flex items-center space-x-3 p-2 hover:bg-white rounded-lg transition-colors duration-200">
                                            <input 
                                                type="checkbox" 
                                                name="attending_assistant_ids" 
                                                value="<%= assistant.id %>"
                                                <%= report.attendingAssistants && report.attendingAssistants.some(a => a.id === assistant.id) ? 'checked' : '' %>
                                                class="w-4 h-4 text-indigo-600 bg-gray-100 border-gray-300 rounded focus:ring-indigo-500 focus:ring-2"
                                            />
                                            <div class="flex items-center space-x-2">
                                                <div class="w-8 h-8 bg-indigo-100 rounded-full flex items-center justify-center">
                                                    <span class="text-xs font-semibold text-indigo-600">
                                                        <%= (assistant.panggilan || assistant.nama_panjang || 'A').charAt(0).toUpperCase() %>
                                                    </span>
                                                </div>
                                                <div>
                                                    <p class="text-sm font-medium text-gray-800">
                                                        <%= assistant.panggilan || assistant.nama_panjang %>
                                                    </p>
                                                    <p class="text-xs text-gray-500">
                                                        <%= assistant.nama_asisten %>
                                                    </p>
                                                </div>
                                            </div>
                                        </label>
                                    <% }) %>
                                </div>
                            <% } else { %>
                                <p class="text-sm text-gray-500">Tidak ada data asisten</p>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>

            <% if (report.receivedAt || report.author || report.imagePath) { %>
                <div class="mt-8 pt-6 border-t border-gray-200">
                    <h4 class="text-sm font-semibold text-gray-700 mb-4">Informasi Tambahan</h4>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="space-y-3">
                            <% if (report.receivedAt) { %>
                                <div class="flex items-center space-x-2">
                                    <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                    </svg>
                                    <span class="text-sm text-gray-600">
                                        Diterima: <%= new Date(report.receivedAt).toLocaleString('id-ID') %>
                                    </span>
                                </div>
                            <% } %>
                            <% if (report.author) { %>
                                <div class="flex items-center space-x-2">
                                    <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                                    </svg>
                                    <span class="text-sm text-gray-600">
                                        Pengirim: <%= report.author %>
                                    </span>
                                </div>
                            <% } %>
                        </div>
                        <% if (report.imagePath) { %>
                            <div>
                                <p class="text-sm font-semibold text-gray-700 mb-2">Gambar Bukti</p>
                                <a href="/<%= report.imagePath.replace(/\\/g, '/') %>" target="_blank" class="block">
                                    <img 
                                        src="/<%= report.imagePath.replace(/\\/g, '/') %>" 
                                        alt="Bukti Kegiatan" 
                                        class="max-w-xs max-h-32 rounded-lg shadow-md hover:opacity-80 transition-opacity duration-200"
                                    />
                                </a>
                                <p class="text-xs text-gray-500 mt-2 break-all">
                                    Path: <%= report.imagePath %>
                                </p>
                            </div>
                        <% } %>
                    </div>
                </div>
            <% } %>

            <div class="mt-8 flex flex-col sm:flex-row justify-between items-center gap-4">
                <div class="flex space-x-3">
                    <button 
                        type="submit" 
                        class="inline-flex items-center px-6 py-3 bg-gradient-to-r from-green-500 to-green-600 hover:from-green-600 hover:to-green-700 text-white font-semibold rounded-xl transition-all duration-200 shadow-lg hover:shadow-xl"
                    >
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                        </svg>
                        Perbarui Laporan
                    </button>
                    <a 
                        href="/laporan" 
                        class="inline-flex items-center px-6 py-3 bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold rounded-xl transition-colors duration-200"
                    >
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                        Batal
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

<%- include('partials/footer') %>