<%- include('partials/header') %>

<div class="max-w-4xl mx-auto space-y-8">
    <!-- Header Section -->
    <div class="text-center">
        <div class="w-20 h-20 bg-gradient-to-br from-blue-500 to-cyan-600 rounded-2xl flex items-center justify-center mx-auto mb-6 shadow-lg">
            <svg class="w-10 h-10 text-white" data-lucide="message-circle"></svg>
        </div>
        <h2 class="text-3xl font-bold text-gray-900 mb-3">WhatsApp Bot Login</h2>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
            Scan QR code menggunakan WhatsApp untuk menghubungkan bot dengan sistem
        </p>
    </div>

    <!-- Status Card -->
    <div class="bg-white rounded-2xl p-8 border border-gray-200 shadow-sm">
        <div class="flex items-center justify-between mb-6">
            <div class="flex items-center space-x-3">
                <div id="statusIndicator" class="w-4 h-4 rounded-full 
                    <% if (status === 'ready') { %>bg-green-500<% } 
                    else if (status === 'qr_ready') { %>bg-yellow-500<% } 
                    else if (status === 'authenticated') { %>bg-blue-500<% } 
                    else if (status === 'auth_failed') { %>bg-red-500<% } 
                    else { %>bg-gray-400<% } %>
                "></div>
                <h3 class="text-lg font-semibold text-gray-900">Status Koneksi</h3>
            </div>
            <button onclick="refreshStatus()" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg transition-colors duration-200">
                <svg class="w-4 h-4 inline mr-2" data-lucide="refresh-cw"></svg>
                Refresh
            </button>
        </div>

        <div id="statusMessage" class="mb-6">
            <% if (status === 'ready') { %>
                <div class="bg-green-50 border border-green-200 rounded-xl p-4">
                    <div class="flex items-center space-x-3">
                        <svg class="w-6 h-6 text-green-600" data-lucide="check-circle"></svg>
                        <div>
                            <h4 class="font-semibold text-green-800">Bot Terhubung!</h4>
                            <p class="text-green-700">WhatsApp bot telah berhasil terhubung dan siap menerima laporan.</p>
                        </div>
                    </div>
                </div>
            <% } else if (status === 'qr_ready') { %>
                <div class="bg-yellow-50 border border-yellow-200 rounded-xl p-4">
                    <div class="flex items-center space-x-3">
                        <svg class="w-6 h-6 text-yellow-600" data-lucide="clock"></svg>
                        <div>
                            <h4 class="font-semibold text-yellow-800">Menunggu Scan QR</h4>
                            <p class="text-yellow-700">Silakan scan QR code di bawah menggunakan WhatsApp Anda.</p>
                        </div>
                    </div>
                </div>
            <% } else if (status === 'authenticated') { %>
                <div class="bg-blue-50 border border-blue-200 rounded-xl p-4">
                    <div class="flex items-center space-x-3">
                        <svg class="w-6 h-6 text-blue-600" data-lucide="shield-check"></svg>
                        <div>
                            <h4 class="font-semibold text-blue-800">Autentikasi Berhasil</h4>
                            <p class="text-blue-700">WhatsApp berhasil diautentikasi, menunggu koneksi final...</p>
                        </div>
                    </div>
                </div>
            <% } else if (status === 'auth_failed') { %>
                <div class="bg-red-50 border border-red-200 rounded-xl p-4">
                    <div class="flex items-center space-x-3">
                        <svg class="w-6 h-6 text-red-600" data-lucide="x-circle"></svg>
                        <div>
                            <h4 class="font-semibold text-red-800">Autentikasi Gagal</h4>
                            <p class="text-red-700">Gagal terhubung ke WhatsApp. Silakan restart dan coba lagi.</p>
                        </div>
                    </div>
                </div>
            <% } else if (status === 'restarting') { %>
                <div class="bg-blue-50 border border-blue-200 rounded-xl p-4">
                    <div class="flex items-center space-x-3">
                        <svg class="w-6 h-6 text-blue-600 animate-spin" data-lucide="loader"></svg>
                        <div>
                            <h4 class="font-semibold text-blue-800">Restarting Bot</h4>
                            <p class="text-blue-700">Bot sedang dimulai ulang, harap tunggu...</p>
                        </div>
                    </div>
                </div>
            <% } else { %>
                <div class="bg-gray-50 border border-gray-200 rounded-xl p-4">
                    <div class="flex items-center space-x-3">
                        <svg class="w-6 h-6 text-gray-600" data-lucide="wifi-off"></svg>
                        <div>
                            <h4 class="font-semibold text-gray-800">Tidak Terhubung</h4>
                            <p class="text-gray-700">Bot WhatsApp sedang tidak terhubung. Menunggu inisialisasi...</p>
                        </div>
                    </div>
                </div>
            <% } %>
        </div>

        <!-- QR Code Display -->
        <div id="qrSection" class="text-center">
            <% if (qrCode) { %>
                <div class="bg-white border-2 border-gray-200 rounded-2xl p-8 inline-block shadow-sm">
                    <img id="qrCodeImage" src="<%= qrCode %>" alt="WhatsApp QR Code" class="w-64 h-64 mx-auto" />
                    <p class="text-sm text-gray-500 mt-4">QR Code akan diperbarui otomatis setiap 30 detik</p>
                </div>
            <% } else { %>
                <div class="bg-gray-50 border-2 border-dashed border-gray-300 rounded-2xl p-16">
                    <svg class="w-16 h-16 text-gray-400 mx-auto mb-4" data-lucide="qr-code"></svg>
                    <p class="text-gray-500">QR Code belum tersedia</p>
                    <p class="text-sm text-gray-400 mt-2">Tunggu beberapa saat atau klik refresh</p>
                </div>
            <% } %>
        </div>

        <!-- Action Buttons -->
        <div class="mt-8 flex justify-center space-x-4">
            <button onclick="restartBot()" class="px-6 py-3 bg-blue-500 hover:bg-blue-600 text-white rounded-xl transition-colors duration-200">
                <svg class="w-4 h-4 inline mr-2" data-lucide="rotate-ccw"></svg>
                Restart Bot
            </button>
            <a href="/whatsapp" class="px-6 py-3 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-xl transition-colors duration-200">
                <svg class="w-4 h-4 inline mr-2" data-lucide="arrow-left"></svg>
                Kembali ke Dashboard
            </a>
        </div>
    </div>

    <!-- Instructions -->
    <div class="bg-blue-50 rounded-2xl p-8">
        <h3 class="text-xl font-semibold text-blue-900 mb-4">Cara Menghubungkan WhatsApp</h3>
        <div class="space-y-4">
            <div class="flex items-start space-x-3">
                <div class="w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center text-blue-600 font-bold text-sm">1</div>
                <div>
                    <p class="text-blue-800 font-medium">Buka WhatsApp di HP Anda</p>
                    <p class="text-blue-700 text-sm">Pastikan WhatsApp sudah terinstall dan aktif</p>
                </div>
            </div>
            <div class="flex items-start space-x-3">
                <div class="w-8 h-8 bg-purple-100 rounded-full flex items-center justify-center text-purple-600 font-bold text-sm">📝</div>
                <div>
                    <p class="text-purple-800 font-medium">Format Tanggal Fleksibel</p>
                    <p class="text-purple-700 text-sm">Bot menerima: "Hari:", "Tanggal:", atau "Hari/Tanggal:" (case insensitive)</p>
                </div>
            </div>
            <div class="flex items-start space-x-3">
                <div class="w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center text-blue-600 font-bold text-sm">2</div>
                <div>
                    <p class="text-blue-800 font-medium">Buka menu WhatsApp Web</p>
                    <p class="text-blue-700 text-sm">Pilih "Linked Devices" atau "WhatsApp Web" dari menu</p>
                </div>
            </div>
            <div class="flex items-start space-x-3">
                <div class="w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center text-blue-600 font-bold text-sm">3</div>
                <div>
                    <p class="text-blue-800 font-medium">Scan QR Code</p>
                    <p class="text-blue-700 text-sm">Arahkan kamera HP ke QR code yang tampil di atas</p>
                </div>
            </div>
            <div class="flex items-start space-x-3">
                <div class="w-8 h-8 bg-green-100 rounded-full flex items-center justify-center text-green-600 font-bold text-sm">✓</div>
                <div>
                    <p class="text-green-800 font-medium">Bot Siap Digunakan!</p>
                    <p class="text-green-700 text-sm">Asisten sudah bisa mengirim laporan melalui WhatsApp</p>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
// Auto refresh status every 5 seconds
let autoRefreshInterval;

function startAutoRefresh() {
    autoRefreshInterval = setInterval(refreshStatus, 5000);
}

function stopAutoRefresh() {
    if (autoRefreshInterval) {
        clearInterval(autoRefreshInterval);
    }
}

async function refreshStatus() {
    try {
        const response = await fetch('/api/whatsapp/status');
        const data = await response.json();
        
        // Update status indicator
        const indicator = document.getElementById('statusIndicator');
        indicator.className = 'w-4 h-4 rounded-full ';
        
        switch(data.status) {
            case 'ready':
                indicator.className += 'bg-green-500';
                break;
            case 'qr_ready':
                indicator.className += 'bg-yellow-500';
                break;
            case 'authenticated':
                indicator.className += 'bg-blue-500';
                break;
            case 'auth_failed':
                indicator.className += 'bg-red-500';
                break;
            default:
                indicator.className += 'bg-gray-400';
        }
        
        // Update QR code if available
        const qrImage = document.getElementById('qrCodeImage');
        const qrSection = document.getElementById('qrSection');
        
        if (data.qrCode && data.hasQR) {
            qrSection.innerHTML = `
                <div class="bg-white border-2 border-gray-200 rounded-2xl p-8 inline-block shadow-sm">
                    <img id="qrCodeImage" src="${data.qrCode}" alt="WhatsApp QR Code" class="w-64 h-64 mx-auto" />
                    <p class="text-sm text-gray-500 mt-4">QR Code akan diperbarui otomatis setiap 30 detik</p>
                </div>
            `;
        } else if (data.status === 'ready') {
            qrSection.innerHTML = `
                <div class="bg-green-50 border-2 border-green-200 rounded-2xl p-16">
                    <svg class="w-16 h-16 text-green-500 mx-auto mb-4" data-lucide="check-circle"></svg>
                    <p class="text-green-700 font-medium">WhatsApp Bot Terhubung!</p>
                    <p class="text-sm text-green-600 mt-2">Siap menerima laporan dari asisten</p>
                </div>
            `;
            // Re-initialize Lucide icons
            lucide.createIcons();
        } else if (data.status === 'authenticated') {
            const pct = data.loading && data.loading.percent ? `${data.loading.percent}%` : '...';
            qrSection.innerHTML = `
                <div class="bg-blue-50 border-2 border-blue-200 rounded-2xl p-16">
                    <svg class="w-16 h-16 text-blue-500 mx-auto mb-4 animate-spin" data-lucide="loader-2"></svg>
                    <p class="text-blue-800 font-medium text-lg">Autentikasi Berhasil!</p>
                    <p class="text-sm text-blue-600 mt-2">Sedang menyinkronkan chat dan kontak (${pct})</p>
                    <p class="text-xs text-blue-500 mt-1">Harap tunggu, bot akan otomatis siap sebentar lagi...</p>
                </div>
            `;
            // Re-initialize Lucide icons
            lucide.createIcons();
        } else if (!data.hasQR) {
            qrSection.innerHTML = `
                <div class="bg-gray-50 border-2 border-dashed border-gray-300 rounded-2xl p-16">
                    <svg class="w-16 h-16 text-gray-400 mx-auto mb-4" data-lucide="qr-code"></svg>
                    <p class="text-gray-500">QR Code belum tersedia</p>
                    <p class="text-sm text-gray-400 mt-2">Tunggu beberapa saat atau klik refresh</p>
                </div>
            `;
            // Re-initialize Lucide icons
            lucide.createIcons();
        }
        
        // Update status message box
        const statusMsgEl = document.getElementById('statusMessage');
        if (statusMsgEl) {
            if (data.status === 'ready') {
                statusMsgEl.innerHTML = `
                    <div class="bg-green-50 border border-green-200 rounded-xl p-4">
                        <div class="flex items-center space-x-3">
                            <svg class="w-6 h-6 text-green-600" data-lucide="check-circle"></svg>
                            <div>
                                <h4 class="font-semibold text-green-800">Bot Terhubung!</h4>
                                <p class="text-green-700">WhatsApp bot telah berhasil terhubung dan siap menerima laporan.</p>
                            </div>
                        </div>
                    </div>`;
            } else if (data.status === 'authenticated') {
                const pct = data.loading && data.loading.percent ? ` (${data.loading.percent}%)` : '';
                statusMsgEl.innerHTML = `
                    <div class="bg-blue-50 border border-blue-200 rounded-xl p-4">
                        <div class="flex items-center space-x-3">
                            <svg class="w-6 h-6 text-blue-600 animate-spin" data-lucide="loader-2"></svg>
                            <div>
                                <h4 class="font-semibold text-blue-800">Autentikasi Berhasil${pct}</h4>
                                <p class="text-blue-700">WhatsApp sedang menyinkronkan data kontak dan riwayat chat...</p>
                            </div>
                        </div>
                    </div>`;
            } else if (data.status === 'qr_ready') {
                statusMsgEl.innerHTML = `
                    <div class="bg-yellow-50 border border-yellow-200 rounded-xl p-4">
                        <div class="flex items-center space-x-3">
                            <svg class="w-6 h-6 text-yellow-600" data-lucide="clock"></svg>
                            <div>
                                <h4 class="font-semibold text-yellow-800">Menunggu Scan QR</h4>
                                <p class="text-yellow-700">Silakan scan QR code di bawah menggunakan WhatsApp Anda.</p>
                            </div>
                        </div>
                    </div>`;
            }
            lucide.createIcons();
        }
        
        console.log('Status updated:', data.status);
        
    } catch (error) {
        console.error('Failed to refresh status:', error);
    }
}

async function restartBot() {
    if (!confirm('Yakin ingin restart WhatsApp bot? Koneksi akan terputus sementara.')) {
        return;
    }
    
    try {
        const response = await fetch('/whatsapp/restart', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        });
        
        const result = await response.json();
        if (result.success) {
            alert('Bot berhasil direstart. Harap tunggu QR code baru...');
            setTimeout(refreshStatus, 2000);
        } else {
            alert('Gagal restart bot: ' + result.error);
        }
    } catch (error) {
        alert('Error: ' + error.message);
    }
}

// Start auto-refresh when page loads
document.addEventListener('DOMContentLoaded', () => {
    startAutoRefresh();
});

// Stop auto-refresh when page is hidden/unloaded
document.addEventListener('visibilitychange', () => {
    if (document.hidden) {
        stopAutoRefresh();
    } else {
        startAutoRefresh();
    }
});

window.addEventListener('beforeunload', stopAutoRefresh);
</script>

<%- include('partials/footer') %> 