<%- include('partials/header') %>

<div class="max-w-2xl mx-auto">
    <!-- Header -->
    <div class="flex items-center space-x-3 mb-8">
        <a href="/asisten" class="p-2 bg-gray-100 hover:bg-gray-200 rounded-lg transition-colors duration-200">
            <svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
            </svg>
        </a>
        <div class="flex items-center space-x-3">
            <div class="w-10 h-10 bg-gradient-to-br from-blue-500 to-blue-600 rounded-xl flex items-center justify-center shadow-lg">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                </svg>
            </div>
            <div>
                <h2 class="text-xl font-bold text-gray-800">Edit Data Asisten</h2>
                <p class="text-sm text-gray-500">Perbarui informasi asisten <span class="font-semibold text-blue-600"><%= assistant.nama_asisten %></span></p>
            </div>
        </div>
    </div>

    <!-- Form -->
    <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
        <div class="bg-gradient-to-r from-blue-50 to-indigo-50 p-6 border-b border-gray-100">
            <div class="flex items-center justify-between">
                <div>
                    <h3 class="text-lg font-semibold text-gray-800">Informasi Asisten</h3>
                    <p class="text-sm text-gray-600 mt-1">Semua field wajib diisi</p>
                </div>
                <div class="text-xs text-gray-400 font-mono bg-white px-3 py-1 rounded-lg">
                    ID: <%= assistant.id %>
                </div>
            </div>
        </div>

        <form method="POST" action="/asisten/update/<%= assistant.id %>" enctype="multipart/form-data" class="p-6 space-y-6">
            <!-- Nama Asisten -->
            <div class="space-y-2">
                <label for="nama_asisten" class="block text-sm font-semibold text-gray-700">
                    Nama Asisten (Kode)
                </label>
                <div class="relative">
                    <input 
                        type="text" 
                        id="nama_asisten" 
                        name="nama_asisten" 
                        value="<%= assistant.nama_asisten %>"
                        placeholder="Contoh: YUNI, DITO, FATIH" 
                        class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors duration-200 bg-gray-50 focus:bg-white"
                        required
                    />
                    <div class="absolute inset-y-0 right-0 flex items-center pr-3">
                        <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                        </svg>
                    </div>
                </div>
                <p class="text-xs text-gray-500">Kode nama asisten (huruf kapital)</p>
            </div>

            <!-- Nama Panjang -->
            <div class="space-y-2">
                <label for="nama_panjang" class="block text-sm font-semibold text-gray-700">
                    Nama Lengkap
                </label>
                <div class="relative">
                    <input 
                        type="text" 
                        id="nama_panjang" 
                        name="nama_panjang" 
                        value="<%= assistant.nama_panjang %>"
                        placeholder="Contoh: Nurwahyuni" 
                        class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors duration-200 bg-gray-50 focus:bg-white"
                        required
                    />
                    <div class="absolute inset-y-0 right-0 flex items-center pr-3">
                        <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                        </svg>
                    </div>
                </div>
                <p class="text-xs text-gray-500">Nama lengkap asisten</p>
            </div>

            <!-- Panggilan -->
            <div class="space-y-2">
                <label for="panggilan" class="block text-sm font-semibold text-gray-700">
                    Nama Panggilan
                </label>
                <div class="relative">
                    <input 
                        type="text" 
                        id="panggilan" 
                        name="panggilan" 
                        value="<%= assistant.panggilan %>"
                        placeholder="Contoh: Princess Yuni" 
                        class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors duration-200 bg-gray-50 focus:bg-white"
                        required
                    />
                    <div class="absolute inset-y-0 right-0 flex items-center pr-3">
                        <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"></path>
                        </svg>
                    </div>
                </div>
                <p class="text-xs text-gray-500">Nama panggilan atau julukan</p>
            </div>

            <!-- Nomor Telepon -->
            <div class="space-y-2">
                <label for="no_telp" class="block text-sm font-semibold text-gray-700">
                    Nomor Telepon
                </label>
                <div class="relative">
                    <input 
                        type="tel" 
                        id="no_telp" 
                        name="no_telp" 
                        value="<%= assistant.no_telp %>"
                        placeholder="Contoh: 0819976134952" 
                        class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors duration-200 bg-gray-50 focus:bg-white"
                        required
                    />
                    <div class="absolute inset-y-0 right-0 flex items-center pr-3">
                        <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                        </svg>
                    </div>
                </div>
                <p class="text-xs text-gray-500">Nomor telepon aktif</p>
            </div>

            <!-- Tanda Tangan (TTD) -->
            <div class="space-y-2">
                <label for="ttd_image" class="block text-sm font-semibold text-gray-700">
                    <div class="flex items-center space-x-2">
                        <svg class="w-4 h-4 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path>
                        </svg>
                        <span>Tanda Tangan (TTD)</span>
                    </div>
                </label>

                <% if (assistant.ttd_image) { %>
                    <!-- TTD yang sudah ada -->
                    <div class="bg-purple-50 border border-purple-200 rounded-xl p-4 mb-3">
                        <p class="text-xs text-purple-600 font-medium mb-2">Tanda Tangan Saat Ini:</p>
                        <div class="flex items-center justify-between gap-4">
                            <img src="<%= assistant.ttd_image %>" alt="TTD <%= assistant.nama_asisten %>" class="max-h-24 rounded-lg shadow-sm border border-purple-100 bg-white p-1" />
                            <label class="flex items-center space-x-2 text-sm text-red-600 cursor-pointer hover:text-red-700">
                                <input type="checkbox" name="hapus_ttd" value="1" class="rounded border-red-300 text-red-600 focus:ring-red-500" id="hapus_ttd_checkbox" />
                                <span>Hapus TTD</span>
                            </label>
                        </div>
                    </div>
                <% } %>

                <div class="border-2 border-dashed border-gray-300 rounded-xl p-6 text-center hover:border-blue-400 transition-colors duration-200 bg-gray-50" id="ttd-drop-zone">
                    <div id="ttd-preview-container" class="hidden mb-4">
                        <img id="ttd-preview" class="max-h-32 mx-auto rounded-lg shadow-sm border border-gray-200" alt="Preview TTD" />
                    </div>
                    <div id="ttd-placeholder">
                        <svg class="w-10 h-10 text-gray-400 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                        </svg>
                        <p class="text-sm text-gray-600 font-medium">
                            <% if (assistant.ttd_image) { %>
                                Klik untuk mengganti tanda tangan
                            <% } else { %>
                                Klik untuk upload gambar tanda tangan
                            <% } %>
                        </p>
                        <p class="text-xs text-gray-400 mt-1">Format: JPG, PNG, GIF, WebP (Maks. 2MB)</p>
                    </div>
                    <input 
                        type="file" 
                        id="ttd_image" 
                        name="ttd_image" 
                        accept="image/jpeg,image/jpg,image/png,image/gif,image/webp"
                        class="hidden"
                    />
                </div>
                <p class="text-xs text-gray-500">Upload gambar baru untuk mengganti tanda tangan (opsional)</p>
            </div>

            <!-- Form Actions -->
            <div class="flex flex-col sm:flex-row gap-3 pt-6 border-t border-gray-100">
                <button 
                    type="submit" 
                    class="flex-1 inline-flex items-center justify-center px-6 py-3 bg-gradient-to-r from-blue-500 to-blue-600 hover:from-blue-600 hover:to-blue-700 text-white font-semibold rounded-xl shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200"
                >
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                    Perbarui Data
                </button>
                <a 
                    href="/asisten" 
                    class="flex-1 inline-flex items-center justify-center px-6 py-3 bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold rounded-xl transition-colors duration-200"
                >
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                    Batal
                </a>
            </div>
        </form>
    </div>
</div>

<script>
    // TTD Image Preview
    const ttdInput = document.getElementById('ttd_image');
    const ttdDropZone = document.getElementById('ttd-drop-zone');
    const ttdPreview = document.getElementById('ttd-preview');
    const ttdPreviewContainer = document.getElementById('ttd-preview-container');
    const ttdPlaceholder = document.getElementById('ttd-placeholder');

    ttdDropZone.addEventListener('click', () => ttdInput.click());

    ttdInput.addEventListener('change', function(e) {
        const file = e.target.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function(ev) {
                ttdPreview.src = ev.target.result;
                ttdPreviewContainer.classList.remove('hidden');
                ttdPlaceholder.innerHTML = '<p class="text-sm text-blue-600 font-medium mt-2">✓ Gambar baru terpilih: ' + file.name + '</p><p class="text-xs text-gray-400 mt-1">Klik untuk mengganti</p>';
            };
            reader.readAsDataURL(file);

            // Otomatis uncheck "hapus TTD" jika ada file baru
            const hapusCheckbox = document.getElementById('hapus_ttd_checkbox');
            if (hapusCheckbox) hapusCheckbox.checked = false;
        }
    });

    // Drag & Drop
    ttdDropZone.addEventListener('dragover', (e) => {
        e.preventDefault();
        ttdDropZone.classList.add('border-blue-400', 'bg-blue-50');
    });
    ttdDropZone.addEventListener('dragleave', () => {
        ttdDropZone.classList.remove('border-blue-400', 'bg-blue-50');
    });
    ttdDropZone.addEventListener('drop', (e) => {
        e.preventDefault();
        ttdDropZone.classList.remove('border-blue-400', 'bg-blue-50');
        if (e.dataTransfer.files.length) {
            ttdInput.files = e.dataTransfer.files;
            ttdInput.dispatchEvent(new Event('change'));
        }
    });
</script>

<%- include('partials/footer') %>