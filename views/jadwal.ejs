<%- include('partials/header') %>

<div class="space-y-4 sm:space-y-6">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div class="flex items-center space-x-3 w-full sm:w-auto">
            <div class="w-10 h-10 sm:w-12 sm:h-12 bg-slate-100 rounded-2xl flex items-center justify-center border border-slate-200 shrink-0">
                <svg class="w-5 h-5 sm:w-6 sm:h-6 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
            </div>
            <div>
                <h2 class="text-lg sm:text-xl font-bold text-slate-900">Manajemen Jadwal</h2>
                <p class="text-xs sm:text-sm text-slate-500">Total: <span class="font-semibold text-slate-600"><%= schedules.length %></span> jadwal</p>
            </div>
        </div>
        
        <a href="/jadwal/add" class="w-full sm:w-auto justify-center inline-flex items-center px-4 sm:px-6 py-2.5 sm:py-3 bg-slate-900 hover:bg-black text-white text-sm sm:text-base font-medium rounded-xl transition-all duration-200">
            <svg class="w-4 h-4 sm:w-5 sm:h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
            </svg>
            Tambah Jadwal Baru
        </a>
    </div>
    
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 bg-white p-4 rounded-2xl border border-gray-200 shadow-sm">
        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-3 w-full sm:w-auto">
            <span class="text-xs sm:text-sm font-medium text-gray-500">Mode Tampilan:</span>
            <div class="flex bg-slate-100 p-1 rounded-xl w-full sm:w-auto">
                <button onclick="switchView('list')" id="listBtn" class="flex-1 sm:flex-none justify-center flex items-center gap-2 px-3 sm:px-4 py-2 rounded-lg text-xs sm:text-sm font-medium transition-all duration-200 bg-white shadow-sm text-slate-900 border border-slate-200">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"></path>
                    </svg>
                    List
                </button>
                <button onclick="switchView('card')" id="cardBtn" class="flex-1 sm:flex-none justify-center flex items-center gap-2 px-3 sm:px-4 py-2 rounded-lg text-xs sm:text-sm font-medium transition-all duration-200 text-slate-500 hover:text-slate-700">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path>
                    </svg>
                    Table Card
                </button>
            </div>
        </div>
        <% if (schedules.length > 0) { %>
            <div class="flex items-center gap-2 text-xs text-gray-500 bg-gray-50 px-3 py-2 rounded-lg sm:bg-transparent sm:px-0 sm:py-0 w-full sm:w-auto">
                <div class="w-2 h-2 bg-purple-500 rounded-full animate-pulse shrink-0"></div>
                <span>Disusun berdasarkan hari (Senin - Sabtu)</span>
            </div>
            <% } %>
        </div>
        
        <% if (schedules.length === 0) { %>
            <div class="text-center py-12 sm:py-16 px-4 bg-white rounded-2xl border border-gray-200 shadow-sm">
                <div class="w-20 h-20 sm:w-24 sm:h-24 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4 sm:mb-6">
                    <svg class="w-10 h-10 sm:w-12 sm:h-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                    </svg>
                </div>
                <h3 class="text-lg sm:text-xl font-semibold text-gray-700 mb-2">Belum Ada Jadwal</h3>
                <p class="text-sm sm:text-base text-gray-500 mb-6">Mulai dengan menambahkan jadwal mata kuliah pertama</p>
                <a href="/jadwal/add" class="w-full sm:w-auto justify-center inline-flex items-center px-6 py-3 bg-gradient-to-r from-purple-500 to-purple-600 text-white font-semibold rounded-xl hover:shadow-lg transition-all duration-200">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                    </svg>
                    Tambah Jadwal
                </a>
            </div>
            <% } else { %>
                <div id="listView" class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
                    <div class="overflow-x-auto">
                        <table class="min-w-full divide-y divide-gray-200 whitespace-nowrap">
                            <thead class="bg-gradient-to-r from-purple-50 to-indigo-50">
                                <tr>
                                    <th class="px-4 sm:px-6 py-3 sm:py-4 text-left text-[10px] sm:text-xs font-semibold text-gray-600 uppercase tracking-wider">
                                        Waktu & Kelas
                                    </th>
                                    <th class="px-4 sm:px-6 py-3 sm:py-4 text-left text-[10px] sm:text-xs font-semibold text-gray-600 uppercase tracking-wider">
                                        Mata Kuliah
                                    </th>
                                    <th class="px-4 sm:px-6 py-3 sm:py-4 text-left text-[10px] sm:text-xs font-semibold text-gray-600 uppercase tracking-wider">
                                        Dosen
                                    </th>
                                    <th class="px-4 sm:px-6 py-3 sm:py-4 text-left text-[10px] sm:text-xs font-semibold text-gray-600 uppercase tracking-wider">
                                        PJ Asisten
                                    </th>
                                    <th class="px-4 sm:px-6 py-3 sm:py-4 text-left text-[10px] sm:text-xs font-semibold text-gray-600 uppercase tracking-wider">
                                        Tim Asisten
                                    </th>
                                    <th class="px-4 sm:px-6 py-3 sm:py-4 text-center text-[10px] sm:text-xs font-semibold text-gray-600 uppercase tracking-wider">
                                        Aksi
                                    </th>
                                </tr>
                            </thead>
                            <tbody class="bg-white divide-y divide-gray-200">
                                <% schedules.forEach((schedule, index) => { %>
                                    <tr class="hover:bg-gray-50 transition-colors duration-200">
                                        <td class="px-4 sm:px-6 py-3 sm:py-4">
                                            <div class="flex items-center space-x-2 sm:space-x-3">
                                                <div class="w-8 h-8 sm:w-10 sm:h-10 bg-gradient-to-br from-purple-100 to-purple-200 rounded-lg flex items-center justify-center shrink-0">
                                                    <svg class="w-4 h-4 sm:w-5 sm:h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                                    </svg>
                                                </div>
                                                <div>
                                                    <p class="text-xs sm:text-sm font-semibold text-gray-800"><%= schedule.day %></p>
                                                    <p class="text-[10px] sm:text-xs text-gray-500"><%= schedule.time %></p>
                                                    <p class="text-[10px] sm:text-xs text-purple-600 font-medium">Kelas <%= schedule.class %></p>
                                                </div>
                                            </div>
                                        </td>
                                        
                                        <td class="px-4 sm:px-6 py-3 sm:py-4">
                                            <div>
                                                <p class="text-xs sm:text-sm font-semibold text-gray-800 whitespace-normal min-w-[150px]">
                                                    <%= schedule.course ? schedule.course.name : 'Mata Kuliah Tidak Ditemukan' %>
                                                </p>
                                                <% if (schedule.course) { %>
                                                    <p class="text-[10px] sm:text-xs text-gray-500">
                                                        <%= schedule.course.code %> • <%= schedule.course.credits %> SKS
                                                    </p>
                                                    <% } %>
                                                </div>
                                            </td>
                                            
                                            <td class="px-4 sm:px-6 py-3 sm:py-4">
                                                <div class="flex items-center space-x-2 min-w-[120px]">
                                                    <div class="w-6 h-6 sm:w-8 sm:h-8 bg-gradient-to-br from-blue-100 to-blue-200 rounded-full flex items-center justify-center shrink-0">
                                                        <span class="text-[10px] sm:text-xs font-semibold text-blue-600">
                                                            <%= schedule.lecturer ? schedule.lecturer.name.charAt(0) : '?' %>
                                                        </span>
                                                    </div>
                                                    <div>
                                                        <p class="text-xs sm:text-sm font-medium text-gray-800 whitespace-normal">
                                                            <%= schedule.lecturer ? schedule.lecturer.name : 'Dosen Tidak Ditemukan' %>
                                                        </p>
                                                        <% if (schedule.lecturer && schedule.lecturer.title) { %>
                                                            <p class="text-[10px] sm:text-xs text-gray-500 whitespace-normal"><%= schedule.lecturer.title %></p>
                                                            <% } %>
                                                        </div>
                                                    </div>
                                                </td>
                                                
                                                <td class="px-4 sm:px-6 py-3 sm:py-4">
                                                    <% if (schedule.pjAssistant) { %>
                                                        <div class="flex items-center space-x-2 min-w-[120px]">
                                                            <div class="w-6 h-6 sm:w-8 sm:h-8 bg-gradient-to-br from-emerald-100 to-emerald-200 rounded-full flex items-center justify-center shrink-0">
                                                                <span class="text-[10px] sm:text-xs font-semibold text-emerald-600">
                                                                    <%= schedule.pjAssistant.nama_asisten.charAt(0) %>
                                                                </span>
                                                            </div>
                                                            <div>
                                                                <p class="text-xs sm:text-sm font-medium text-gray-800 whitespace-normal"><%= schedule.pjAssistant.nama_asisten %></p>
                                                                <p class="text-[10px] sm:text-xs text-gray-500 whitespace-normal"><%= schedule.pjAssistant.panggilan %></p>
                                                            </div>
                                                        </div>
                                                        <% } else { %>
                                                            <span class="text-xs sm:text-sm text-gray-400">Tidak ada PJ</span>
                                                            <% } %>
                                                        </td>
                                                        
                                                        <td class="px-4 sm:px-6 py-3 sm:py-4">
                                                            <% if (schedule.assistants && schedule.assistants.length > 0) { %>
                                                                <div class="flex flex-wrap gap-1 min-w-[150px]">
                                                                    <% schedule.assistants.forEach(assistant => { %>
                                                                        <span class="inline-flex items-center px-1.5 sm:px-2 py-0.5 sm:py-1 rounded-full text-[10px] sm:text-xs font-medium bg-gray-100 text-gray-700">
                                                                            <%= assistant.nama_asisten %>
                                                                        </span>
                                                                        <% }) %>
                                                                    </div>
                                                                    <% } else { %>
                                                                        <span class="text-xs sm:text-sm text-gray-400">Tidak ada asisten</span>
                                                                        <% } %>
                                                                    </td>
                                                                    
                                                                    <td class="px-4 sm:px-6 py-3 sm:py-4 text-center">
                                                                        <div class="flex flex-col sm:flex-row items-center justify-center gap-1.5 sm:space-x-2">
                                                                            <a href="/jadwal/edit/<%= schedule.id %>" class="w-full sm:w-auto justify-center inline-flex items-center px-2 sm:px-3 py-1.5 sm:py-2 bg-blue-50 hover:bg-blue-100 text-blue-700 text-xs sm:text-sm font-medium rounded-lg transition-colors duration-200">
                                                                                <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 mr-1 sm:mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                                                                                </svg>
                                                                                Edit
                                                                            </a>
                                                                            <form method="POST" action="/jadwal/delete/<%= schedule.id %>" class="w-full sm:w-auto inline m-0" onsubmit="return confirm('Apakah Anda yakin ingin menghapus jadwal ini kelas <%= schedule.class %>?')">
                                                                                <button type="submit" class="w-full sm:w-auto justify-center inline-flex items-center px-2 sm:px-3 py-1.5 sm:py-2 bg-red-50 hover:bg-red-100 text-red-700 text-xs sm:text-sm font-medium rounded-lg transition-colors duration-200">
                                                                                    <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 mr-1 sm:mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                                                                    </svg>
                                                                                    Hapus
                                                                                </button>
                                                                            </form>
                                                                        </div>
                                                                    </td>
                                                                </tr>
                                                                <% }) %>
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </div>
                                                
                                                <div id="cardView" class="hidden">
                                                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
                                                        <% const dayList = ['Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu']; %>
                                                        <% dayList.forEach(dayName => { %>
                                                            <div class="flex flex-col gap-3 sm:gap-4">
                                                                <div class="bg-blue-50 rounded-2xl p-3 sm:p-4 border border-blue-100 flex items-center justify-between shadow-sm">
                                                                    <h3 class="font-bold text-blue-900 text-sm sm:text-base"><%= dayName %></h3>
                                                                    <% const dayCount = schedules.filter(s => s.day === dayName).length; %>
                                                                    <span class="text-[10px] px-2 py-1 sm:px-2.5 sm:py-1 bg-white text-blue-600 rounded-lg font-black border border-blue-100 uppercase tracking-wider"><%= dayCount %> SESI</span>
                                                                </div>
                                                                
                                                                <% const daySchedules = schedules.filter(s => s.day === dayName).sort((a,b) => a.time.localeCompare(b.time)); %>
                                                                <% if (daySchedules.length === 0) { %>
                                                                    <div class="bg-slate-50/50 rounded-2xl border border-dashed border-slate-200 py-8 sm:py-10 px-4 text-center">
                                                                        <p class="text-[10px] sm:text-xs text-slate-400 font-medium">Kosong</p>
                                                                    </div>
                                                                    <% } else { %>
                                                                        <div class="space-y-3 sm:space-y-4">
                                                                            <% daySchedules.forEach(s => { %>
                                                                                <div class="bg-white rounded-2xl border border-slate-200 p-4 sm:p-5 hover:border-slate-400 transition-all duration-200 group relative shadow-sm">
                                                                                    <div class="absolute top-2 sm:top-3 right-2 sm:right-3 flex gap-1.5 sm:gap-2 opacity-100 sm:opacity-0 sm:group-hover:opacity-100 transition-opacity">
                                                                                        <a href="/jadwal/edit/<%= s.id %>" class="w-6 h-6 sm:w-7 sm:h-7 flex items-center justify-center bg-slate-50 text-blue-600 hover:bg-blue-50 rounded-full border border-slate-200 hover:border-blue-200 transition-colors" title="Edit">
                                                                                            <svg class="w-3 h-3 sm:w-3.5 sm:h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                                                                                        </a>
                                                                                        <form method="POST" action="/jadwal/delete/<%= s.id %>" class="m-0" onsubmit="return confirm('Apakah Anda yakin ingin menghapus jadwal ini?')">
                                                                                            <button type="submit" class="w-6 h-6 sm:w-7 sm:h-7 flex items-center justify-center bg-slate-50 text-red-500 hover:bg-red-50 rounded-full border border-slate-200 hover:border-red-200 transition-colors" title="Hapus">
                                                                                                <svg class="w-3 h-3 sm:w-3.5 sm:h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                                                                            </button>
                                                                                        </form>
                                                                                    </div>
                                                                                    
                                                                                    <div class="flex items-center justify-between mb-2 sm:mb-3 border-b border-slate-50 pb-2 pr-16 sm:pr-0">
                                                                                        <div class="flex items-center gap-1.5">
                                                                                            <span class="text-[10px] sm:text-xs font-bold text-slate-900">
                                                                                                <%= s.time %>
                                                                                            </span>
                                                                                        </div>
                                                                                        <span class="text-[9px] sm:text-[10px] font-bold text-slate-500 bg-slate-100 px-1.5 py-0.5 sm:px-2 sm:py-0.5 rounded uppercase tracking-tighter">
                                                                                            KLS <%= s.class %>
                                                                                        </span>
                                                                                    </div>
                                                                                    
                                                                                    <h4 class="text-xs sm:text-sm font-bold text-slate-900 leading-tight mb-3 sm:mb-4 line-clamp-2 pr-12 sm:pr-0">
                                                                                        <%= s.course ? s.course.name : 'Mata Kuliah Tidak Ditemukan' %>
                                                                                    </h4>
                                                                                    
                                                                                    <div class="space-y-2 sm:space-y-3">
                                                                                        <div class="flex items-center gap-2">
                                                                                            <div class="w-4 h-4 sm:w-5 sm:h-5 rounded bg-slate-100 flex items-center justify-center shrink-0">
                                                                                                <svg class="w-2.5 h-2.5 sm:w-3 sm:h-3 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                                                                                            </div>
                                                                                            <span class="text-[10px] sm:text-[11px] font-medium text-slate-600 truncate">
                                                                                                <%= s.lecturer ? s.lecturer.name : 'Dosen Tidak Ditemukan' %>
                                                                                            </span>
                                                                                        </div>
                                                                                        
                                                                                        <% if (s.pjAssistant) { %>
                                                                                            <div class="flex items-center gap-2">
                                                                                                <div class="w-4 h-4 sm:w-5 sm:h-5 rounded bg-blue-50 flex items-center justify-center shrink-0">
                                                                                                    <svg class="w-2.5 h-2.5 sm:w-3 sm:h-3 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                                                                                </div>
                                                                                                <span class="text-[10px] sm:text-[11px] font-semibold text-blue-700 truncate">PJ: <%= s.pjAssistant.nama_asisten %></span>
                                                                                            </div>
                                                                                            <% } %>
                                                                                            
                                                                                            <% if (s.assistants && s.assistants.length > 0) { %>
                                                                                                <div class="flex flex-col gap-1 pt-1.5 sm:pt-2">
                                                                                                    <p class="text-[8px] sm:text-[9px] text-slate-400 font-bold uppercase tracking-widest pl-1">Tim Asisten</p>
                                                                                                    <div class="flex flex-wrap gap-1">
                                                                                                        <% s.assistants.forEach(assistant => { %>
                                                                                                            <span class="text-[9px] sm:text-[10px] font-medium text-slate-500 bg-slate-50 px-1.5 py-0.5 sm:px-2 sm:py-0.5 rounded border border-slate-100">
                                                                                                                <%= assistant.nama_asisten %>
                                                                                                            </span>
                                                                                                            <% }) %>
                                                                                                        </div>
                                                                                                    </div>
                                                                                                    <% } %>
                                                                                                </div>
                                                                                            </div>
                                                                                            <% }) %>
                                                                                        </div>
                                                                                        <% } %>
                                                                                    </div>
                                                                                    <% }) %>
                                                                                </div>
                                                                            </div>
                                                                            <% } %>
                                                                        </div>
                                                                        
                                                                        <script>
                                                                            function switchView(view) {
                                                                                const listView = document.getElementById('listView');
                                                                                const cardView = document.getElementById('cardView');
                                                                                const listBtn = document.getElementById('listBtn');
                                                                                const cardBtn = document.getElementById('cardBtn');
                                                                                
                                                                                if (view === 'list') {
                                                                                    listView.classList.remove('hidden');
                                                                                    cardView.classList.add('hidden');
                                                                                    
                                                                                    listBtn.classList.add('bg-white', 'shadow-sm', 'text-slate-900', 'border', 'border-slate-200');
                                                                                    listBtn.classList.remove('text-slate-500', 'hover:text-slate-700', 'border-transparent');
                                                                                    
                                                                                    cardBtn.classList.remove('bg-white', 'shadow-sm', 'text-slate-900', 'border', 'border-slate-200');
                                                                                    cardBtn.classList.add('text-slate-500', 'hover:text-slate-700', 'border-transparent');
                                                                                    
                                                                                    localStorage.setItem('jadwalViewPreference', 'list');
                                                                                } else {
                                                                                    listView.classList.add('hidden');
                                                                                    cardView.classList.remove('hidden');
                                                                                    
                                                                                    cardBtn.classList.add('bg-white', 'shadow-sm', 'text-slate-900', 'border', 'border-slate-200');
                                                                                    cardBtn.classList.remove('text-slate-500', 'hover:text-slate-700', 'border-transparent');
                                                                                    
                                                                                    listBtn.classList.remove('bg-white', 'shadow-sm', 'text-slate-900', 'border', 'border-slate-200');
                                                                                    listBtn.classList.add('text-slate-500', 'hover:text-slate-700', 'border-transparent');
                                                                                    
                                                                                    localStorage.setItem('jadwalViewPreference', 'card');
                                                                                }
                                                                            }
                                                                            
                                                                            // Load preference
                                                                            document.addEventListener('DOMContentLoaded', () => {
                                                                                const pref = localStorage.getItem('jadwalViewPreference');
                                                                                if (pref === 'card') {
                                                                                    switchView('card');
                                                                                } else {
                                                                                    // Default list styles applied via script to ensure borders match state
                                                                                    switchView('list');
                                                                                }
                                                                            });
