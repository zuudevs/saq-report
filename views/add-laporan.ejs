<%- include('partials/header') %>

<div class="max-w-6xl mx-auto space-y-6">
    <div class="flex items-center space-x-4">
        <a href="/laporan" class="inline-flex items-center px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium rounded-xl transition-colors duration-200">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
            </svg>
            Kembali
        </a>
        <div>
            <h2 class="text-2xl font-bold text-gray-800">Tambah Laporan Baru</h2>
            <p class="text-sm text-gray-600">Buat laporan kegiatan praktikum baru</p>
        </div>
    </div>

    <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
        <div class="bg-gradient-to-r from-blue-50 to-indigo-50 p-6 border-b border-gray-100">
            <h3 class="text-lg font-semibold text-gray-800">Informasi Laporan</h3>
            <p class="text-sm text-gray-600 mt-1">Lengkapi semua informasi yang diperlukan</p>
        </div>

        <form action="/laporan/add" method="POST" enctype="multipart/form-data" class="p-6">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                <div class="space-y-6">
                    <div class="bg-gray-50 rounded-xl p-4">
                        <h4 class="text-sm font-semibold text-gray-700 mb-3">Informasi Jadwal</h4>
                        
                        <div class="space-y-4">
                            <div class="space-y-2">
                                <label for="schedule_id" class="block text-sm font-semibold text-gray-700">
                                    Jadwal <span class="text-red-500">*</span>
                                </label>
                                <div class="relative">
                                    <select 
                                        name="schedule_id" 
                                        id="schedule_id" 
                                        required
                                        class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors duration-200 bg-white appearance-none"
                                    >
                                        <option value="">Pilih Jadwal Praktikum</option>
                                        <% schedules.forEach(schedule => { %>
                                            <option value="<%= schedule.id %>" <%= prefilled.schedule === schedule.id ? 'selected' : '' %>>
                                                <%= schedule.course ? `${schedule.course.code} - ${schedule.course.name}` : 'Mata Kuliah Tidak Ditemukan' %> • 
                                                Kelas <%= schedule.class %> • 
                                                <%= schedule.day %> <%= schedule.time %>
                                                <% if (schedule.lecturer) { %> • <%= schedule.lecturer.name %><% } %>
                                            </option>
                                        <% }) %>
                                    </select>
                                    <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none">
                                        <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                                        </svg>
                                    </div>
                                </div>
                            </div>

                            <div class="space-y-2">
                                <label for="date" class="block text-sm font-semibold text-gray-700">
                                    Tanggal Kegiatan <span class="text-red-500">*</span>
                                </label>
                                <input 
                                    type="date" 
                                    name="date" 
                                    id="date" 
                                    value="<%= prefilled.date || new Date().toISOString().split('T')[0] %>"
                                    required
                                    class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors duration-200 bg-white"
                                />
                            </div>
                        </div>
                    </div>

                    <div class="space-y-2">
                        <label for="status" class="block text-sm font-semibold text-gray-700">
                            Status Kegiatan <span class="text-red-500">*</span>
                        </label>
                        <div class="relative">
                            <select 
                                name="status" 
                                id="status" 
                                required
                                class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors duration-200 bg-white appearance-none"
                            >
                                <option value="">Pilih Status</option>
                                <option value="hadir">Hadir</option>
                                <option value="libur">Libur</option>
                                <option value="pengganti">Pengganti</option>
                                <option value="belum ada laporan">Belum Ada Laporan</option>
                            </select>
                            <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none">
                                <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                                </svg>
                            </div>
                        </div>
                    </div>

                    <div class="space-y-2">
                        <label for="materi" class="block text-sm font-semibold text-gray-700">
                            Materi yang Diajarkan
                        </label>
                        <input 
                            type="text" 
                            name="materi" 
                            id="materi" 
                            placeholder="Contoh: Pengenalan Database, SQL Basics, dll"
                            class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors duration-200 bg-gray-50 focus:bg-white"
                        />
                    </div>
                </div>

                <div class="space-y-6">
                    <div class="space-y-2">
                        <label for="deskripsiKegiatan" class="block text-sm font-semibold text-gray-700">
                            Deskripsi Kegiatan
                        </label>
                        <textarea 
                            name="deskripsiKegiatan" 
                            id="deskripsiKegiatan" 
                            rows="4"
                            placeholder="Jelaskan kegiatan yang dilakukan selama praktikum, metode pembelajaran, dan hal-hal penting lainnya"
                            class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors duration-200 bg-gray-50 focus:bg-white resize-none"
                        ></textarea>
                    </div>

                    <div class="space-y-2">
                        <label for="keterangan" class="block text-sm font-semibold text-gray-700">
                            Keterangan Tambahan
                        </label>
                        <textarea 
                            name="keterangan" 
                            id="keterangan" 
                            rows="3"
                            placeholder="Catatan khusus, kendala yang dihadapi, atau informasi tambahan lainnya"
                            class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors duration-200 bg-gray-50 focus:bg-white resize-none"
                        ></textarea>
                    </div>

                    <div class="space-y-2">
                        <label for="reportImage" class="block text-sm font-semibold text-gray-700">
                            Upload Bukti Kegiatan
                        </label>
                        <div class="relative">
                            <input 
                                type="file" 
                                name="reportImage" 
                                id="reportImage" 
                                accept="image/*"
                                class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors duration-200 bg-gray-50 focus:bg-white file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100"
                            />
                            <p class="text-xs text-gray-500 mt-2">
                                Format: JPG, PNG, GIF. Maksimal 5MB.
                            </p>
                        </div>
                        
                        <!-- Preview area -->
                        <div id="imagePreview" class="hidden mt-4">
                            <p class="text-sm font-semibold text-gray-700 mb-2">Preview:</p>
                            <img id="previewImg" src="" alt="Preview" class="max-w-xs max-h-32 rounded-lg shadow-md border border-gray-200" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Asisten yang Hadir -->
            <div class="mt-8 space-y-2">
                <label class="block text-sm font-semibold text-gray-700">
                    Asisten yang Hadir <span class="text-red-500">*</span>
                </label>
                <p class="text-xs text-gray-500 mb-3">Pilih asisten yang hadir dalam kegiatan praktikum ini</p>
                <div class="bg-gray-50 rounded-xl p-4 max-h-48 overflow-y-auto">
                    <% if (assistants && assistants.length > 0) { %>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
                            <% assistants.forEach(assistant => { %>
                                <label class="flex items-center space-x-3 p-3 hover:bg-white rounded-lg transition-colors duration-200 cursor-pointer">
                                    <input 
                                        type="checkbox" 
                                        name="attending_assistant_ids" 
                                        value="<%= assistant.id %>"
                                        class="w-4 h-4 text-blue-600 bg-gray-100 border-gray-300 rounded focus:ring-blue-500 focus:ring-2"
                                        <%= (selectedSchedule && (selectedSchedule.assistant_ids.includes(assistant.id) || selectedSchedule.pj_assistant_id === assistant.id)) ? 'checked' : '' %>
                                    />
                                    <div class="flex items-center space-x-3">
                                        <div class="w-10 h-10 bg-blue-100 rounded-full flex items-center justify-center">
                                            <span class="text-sm font-bold text-blue-600">
                                                <%= (assistant.panggilan || assistant.nama_panjang || 'A').charAt(0).toUpperCase() %>
                                            </span>
                                        </div>
                                        <div class="flex-1">
                                            <p class="text-sm font-medium text-gray-800">
                                                <%= assistant.panggilan || assistant.nama_panjang %>
                                            </p>
                                            <p class="text-xs text-gray-500">
                                                <%= assistant.nama_asisten %>
                                            </p>
                                        </div>
                                    </div>
                                </label>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <p class="text-sm text-gray-500 text-center py-4">Tidak ada data asisten tersedia</p>
                    <% } %>
                </div>
            </div>

            <!-- Submit buttons -->
            <div class="mt-8 flex flex-col sm:flex-row justify-between items-center gap-4">
                <div class="flex space-x-3">
                    <button 
                        type="submit" 
                        class="inline-flex items-center px-6 py-3 bg-gradient-to-r from-blue-500 to-blue-600 hover:from-blue-600 hover:to-blue-700 text-white font-semibold rounded-xl transition-all duration-200 shadow-lg hover:shadow-xl"
                    >
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                        </svg>
                        Simpan Laporan
                    </button>
                    <a 
                        href="/laporan" 
                        class="inline-flex items-center px-6 py-3 bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold rounded-xl transition-colors duration-200"
                    >
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                        Batal
                    </a>
                </div>
                <div class="text-sm text-gray-500">
                    <span class="text-red-500">*</span> Field wajib diisi
                </div>
            </div>
        </form>
    </div>
</div>

<script>
// Image preview functionality
document.getElementById('reportImage').addEventListener('change', function(e) {
    const file = e.target.files[0];
    const preview = document.getElementById('imagePreview');
    const previewImg = document.getElementById('previewImg');
    
    if (file) {
        const reader = new FileReader();
        reader.onload = function(e) {
            previewImg.src = e.target.result;
            preview.classList.remove('hidden');
        }
        reader.readAsDataURL(file);
    } else {
        preview.classList.add('hidden');
    }
});

// Form validation
document.querySelector('form').addEventListener('submit', function(e) {
    const scheduleId = document.getElementById('schedule_id').value;
    const status = document.getElementById('status').value;
    const attendingAssistants = document.querySelectorAll('input[name="attending_assistant_ids"]:checked');
    
    if (!scheduleId) {
        alert('Silakan pilih jadwal praktikum!');
        e.preventDefault();
        return;
    }
    
    if (!status) {
        alert('Silakan pilih status kegiatan!');
        e.preventDefault();
        return;
    }
    
    if (attendingAssistants.length === 0) {
        alert('Silakan pilih minimal satu asisten yang hadir!');
        e.preventDefault();
        return;
    }
});

// Auto-populate assistants based on schedule selection
// Note: Initial auto-fill handled by server-side when coming from links
document.getElementById('schedule_id').addEventListener('change', function() {
    console.log('Schedule changed - for dynamic auto-fill, implement AJAX call to get schedule data');
});
</script>

<%- include('partials/footer') %> 