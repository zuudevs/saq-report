<%- include('partials/header') %>

<div class="space-y-4 sm:space-y-6">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div class="flex items-center space-x-3 w-full sm:w-auto">
            <div class="w-10 h-10 sm:w-12 sm:h-12 bg-gradient-to-br from-blue-500 to-blue-600 rounded-xl flex items-center justify-center shadow-lg shrink-0">
                <svg class="w-5 h-5 sm:w-6 sm:h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"></path>
                </svg>
            </div>
            <div>
                <h2 class="text-lg sm:text-xl font-bold text-gray-800">Manajemen Dosen</h2>
                <p class="text-xs sm:text-sm text-gray-500">Total: <span class="font-semibold text-blue-600"><%= lecturers.length %></span> dosen</p>
            </div>
        </div>
        
        <a href="/dosen/add" class="w-full sm:w-auto justify-center inline-flex items-center px-4 sm:px-6 py-2.5 sm:py-3 bg-gradient-to-r from-blue-500 to-blue-600 hover:from-blue-600 hover:to-blue-700 text-white text-sm sm:text-base font-semibold rounded-xl shadow-lg hover:shadow-xl transform sm:hover:-translate-y-0.5 transition-all duration-200">
            <svg class="w-4 h-4 sm:w-5 sm:h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
            </svg>
            Tambah Dosen Baru
        </a>
    </div>
    
    <% if (lecturers.length === 0) { %>
        <div class="text-center py-12 sm:py-16 px-4 bg-white rounded-2xl border border-gray-200 shadow-sm">
            <div class="w-20 h-20 sm:w-24 sm:h-24 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4 sm:mb-6">
                <svg class="w-10 h-10 sm:w-12 sm:h-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"></path>
                </svg>
            </div>
            <h3 class="text-lg sm:text-xl font-semibold text-gray-700 mb-2">Belum Ada Data Dosen</h3>
            <p class="text-sm sm:text-base text-gray-500 mb-6">Mulai dengan menambahkan data dosen pertama</p>
            <a href="/dosen/add" class="w-full sm:w-auto justify-center inline-flex items-center px-6 py-3 bg-gradient-to-r from-blue-500 to-blue-600 text-white font-semibold rounded-xl hover:shadow-lg transition-all duration-200">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                </svg>
                Tambah Dosen
            </a>
        </div>
        <% } else { %>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
                <% lecturers.forEach(lecturer => { %>
                    <div class="bg-white rounded-2xl border border-gray-200 shadow-sm hover:shadow-lg transition-all duration-300 overflow-hidden group">
                        <div class="bg-gradient-to-r from-blue-50 to-indigo-50 p-4 sm:p-6 border-b border-gray-100">
                            <div class="flex items-center space-x-3 sm:space-x-4">
                                <div class="w-12 h-12 sm:w-16 sm:h-16 bg-gradient-to-br from-blue-500 to-blue-600 rounded-xl flex items-center justify-center shadow-lg shrink-0">
                                    <span class="text-lg sm:text-xl font-bold text-white">
                                        <%= lecturer.name.charAt(0).toUpperCase() %>
                                    </span>
                                </div>
                                <div class="flex-1 min-w-0">
                                    <h3 class="text-base sm:text-lg font-bold text-gray-800 group-hover:text-blue-600 transition-colors duration-200 truncate" title="<%= lecturer.name %>">
                                        <%= lecturer.name %>
                                    </h3>
                                    <% if (lecturer.title) { %>
                                        <p class="text-xs sm:text-sm text-blue-600 font-medium truncate" title="<%= lecturer.title %>"><%= lecturer.title %></p>
                                        <% } %>
                                        <div class="text-[10px] sm:text-xs text-gray-400 font-mono bg-white px-2 py-1 rounded mt-1 sm:mt-2 inline-block border border-gray-100">
                                            ID: <%= lecturer.id %>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="p-4 sm:p-6 space-y-3 sm:space-y-4">
                                <div class="space-y-2.5 sm:space-y-3">
                                    <% if (lecturer.email) { %>
                                        <div class="flex items-center space-x-3">
                                            <div class="w-7 h-7 sm:w-8 sm:h-8 bg-gray-100 rounded-lg flex items-center justify-center shrink-0">
                                                <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                                                </svg>
                                            </div>
                                            <div class="min-w-0 flex-1">
                                                <p class="text-[10px] sm:text-xs text-gray-500">Email</p>
                                                <p class="text-xs sm:text-sm font-semibold text-gray-800 truncate" title="<%= lecturer.email %>"><%= lecturer.email %></p>
                                            </div>
                                        </div>
                                        <% } %>
                                        
                                        <% if (lecturer.phone) { %>
                                            <div class="flex items-center space-x-3">
                                                <div class="w-7 h-7 sm:w-8 sm:h-8 bg-gray-100 rounded-lg flex items-center justify-center shrink-0">
                                                    <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                                                    </svg>
                                                </div>
                                                <div class="min-w-0 flex-1">
                                                    <p class="text-[10px] sm:text-xs text-gray-500">Telepon</p>
                                                    <p class="text-xs sm:text-sm font-semibold text-gray-800 truncate"><%= lecturer.phone %></p>
                                                </div>
                                            </div>
                                            <% } %>
                                            
                                            <% if (lecturer.department) { %>
                                                <div class="flex items-center space-x-3">
                                                    <div class="w-7 h-7 sm:w-8 sm:h-8 bg-gray-100 rounded-lg flex items-center justify-center shrink-0">
                                                        <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                                                        </svg>
                                                    </div>
                                                    <div class="min-w-0 flex-1">
                                                        <p class="text-[10px] sm:text-xs text-gray-500">Departemen</p>
                                                        <p class="text-xs sm:text-sm font-semibold text-gray-800 truncate" title="<%= lecturer.department %>"><%= lecturer.department %></p>
                                                    </div>
                                                </div>
                                                <% } %>
                                            </div>
                                        </div>
                                        
                                        <div class="px-4 pb-4 sm:px-6 sm:pb-6 mt-auto">
                                            <div class="flex space-x-2">
                                                <a href="/dosen/edit/<%= lecturer.id %>" class="flex-1 inline-flex items-center justify-center px-3 py-2 sm:px-4 sm:py-2.5 text-xs sm:text-sm bg-blue-50 hover:bg-blue-100 text-blue-700 font-medium rounded-xl transition-colors duration-200">
                                                    <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 mr-1.5 sm:mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                                                    </svg>
                                                    Edit
                                                </a>
                                                <form method="POST" action="/dosen/delete/<%= lecturer.id %>" class="flex-1" onsubmit="return confirm('Apakah Anda yakin ingin menghapus data dosen <%= lecturer.name %>?')">
                                                    <button type="submit" class="w-full inline-flex items-center justify-center px-3 py-2 sm:px-4 sm:py-2.5 text-xs sm:text-sm bg-red-50 hover:bg-red-100 text-red-700 font-medium rounded-xl transition-colors duration-200">
                                                        <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 mr-1.5 sm:mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                                        </svg>
                                                        Hapus
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                    <% }) %>
                                </div>
                                <% } %>
                            </div>
                            
                            <%- include('partials/footer') %>