# Server Configuration
PORT=3000

# MongoDB Configuration (untuk npm start)
MONGO_URL=mongodb://localhost:27017/saq_whatsapp
MONGO_PUBLIC_URL=
MONGOHOST=localhost
MONGOPORT=27017
MONGOUSER=
MONGOPASSWORD=

# Google Gemini API Key (untuk AI message generator)
GEMINI_API_KEY=

# Benchmark parser JSON (npm run start:raw-benchmark / benchmark:json:real)
BENCHMARK_HOST=127.0.0.1
BENCHMARK_PORT=3100
# Opsional: direktori data benchmark (default: output/benchmarks/json-parser)
JSON_PARSER_BENCHMARK_DIR=
# Opsional: file data JSON Lines lengkap (default: <direktori>/raw_benchmark_data.json)
RAW_BENCHMARK_DATA_FILE=
# Opsional: URL endpoint benchmark untuk feeder (default: http://127.0.0.1:3100/benchmark)
JSON_BENCHMARK_URL=
