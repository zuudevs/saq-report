# Server Configuration
PORT=3000

# MongoDB Configuration
MONGO_URL=mongodb://localhost:27017/saq_whatsapp
MONGO_PUBLIC_URL=
MONGOHOST=localhost
MONGOPORT=27017
MONGOUSER=
MONGOPASSWORD=

# Google Gemini API Key (untuk AI message generator)
GEMINI_API_KEY=

# JSON parser comparison (aktifkan lewat npm run start:benchmark)
JSON_PARSER_BENCHMARK=0
# Opsional: direktori output benchmark (default: output/benchmarks/json-parser)
JSON_PARSER_BENCHMARK_DIR=
# Opsional: path ke WASM hasil build (default: vendor/ze_json/build/wasm64-release/src/ze_json_core.wasm)
ZE_JSON_WASM_PATH=
