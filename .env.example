# Server Configuration
PORT=3000

# MongoDB Configuration (untuk npm start / npm run start:benchmark:app)
MONGO_URL=mongodb://localhost:27017/saq_whatsapp
MONGO_PUBLIC_URL=
MONGOHOST=localhost
MONGOPORT=27017
MONGOUSER=
MONGOPASSWORD=

# Google Gemini API Key (untuk AI message generator)
GEMINI_API_KEY=

# JSON parser comparison
# npm run start:benchmark menjalankan server mandiri tanpa MongoDB/Docker.
JSON_PARSER_BENCHMARK=0
BENCHMARK_HOST=127.0.0.1
BENCHMARK_PORT=3100
# Opsional: direktori output benchmark (default: output/benchmarks/json-parser)
JSON_PARSER_BENCHMARK_DIR=
